# Vorlage für /etc/psagent/psagent.env auf dem Pi (#22). Kopieren, Werte eintragen,
# `chmod 600`, Besitzer root. Die echte Datei kommt nie ins Repo (CLAUDE.md, Regel 2).
# Platzhalter in <spitzen Klammern> ersetzen; leere Werte bleiben leer, bis der Dienst steht.

# --- Datenbank (gilt für App und PostgreSQL) ---
POSTGRES_PASSWORD=<langes zufälliges Passwort, z. B. openssl rand -base64 32>

# --- Django ---
DJANGO_SECRET_KEY=<langer zufälliger Schlüssel, z. B. openssl rand -base64 48>
# Tailscale-Name des Pi; darf sich später nicht mehr ändern (Passkeys hängen daran).
DJANGO_ALLOWED_HOSTS=psagent.<tailnet>.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://psagent.<tailnet>.ts.net
PSAGENT_WEBAUTHN_RP_ID=psagent.<tailnet>.ts.net
PSAGENT_WEBAUTHN_ORIGINS=https://psagent.<tailnet>.ts.net
PSAGENT_BASE_URL=https://psagent.<tailnet>.ts.net

# --- Verein ---
PSAGENT_CLUB_NAME=<Name des Vereins, wie auf der Einsatzdokumentation>
PSAGENT_RETENTION_YEARS=3

# --- E-Mail über Microsoft 365 (docs/runbooks/mail-m365.md) ---
PSAGENT_MAIL_BACKEND=mailer.graph.GraphEmailBackend
PSAGENT_MAIL_FROM=<Absender, z. B. psagent@verein.example>
PSAGENT_MAIL_REPLY_TO=<Antwortadresse, z. B. material@verein.example>
PSAGENT_GRAPH_TENANT_ID=
PSAGENT_GRAPH_CLIENT_ID=
PSAGENT_GRAPH_CERT_PATH=/etc/psagent/certs/graph.pem
PSAGENT_GRAPH_CERT_THUMBPRINT=

# --- Zeitstempel und Zeuge (docs/runbooks/kettenkopf.md) ---
PSAGENT_TSA_URL=
PSAGENT_TSA_CA_PATH=/etc/psagent/certs/tsa-ca.pem
PSAGENT_WITNESS_TO=<Zeugen-Postfach des Vorstands>

# --- Zertifikatsliste und YubiKeys (docs/runbooks/zertifikate.md) ---
PSAGENT_YUBICO_CA_PATH=/etc/psagent/certs/yubico-piv-ca.pem
PSAGENT_YUBIKEY_SERIALS=
PSAGENT_YUBICO_FIDO_CA_PATH=/etc/psagent/certs/yubico-fido-ca.pem

# --- Sicherung nach Unraid (docs/runbooks/sicherung.md) ---
# Unraid über seinen Tailscale-Namen ansprechen: WAL-G prüft den SSH-Host-Schlüssel nicht, das
# Tailnet (WireGuard) stellt sicher, dass die Gegenstelle Unraid ist. Absoluter Pfad auf Unraid.
WALG_SSH_PREFIX=ssh://<unraid>.<tailnet>.ts.net/<Pfad auf Unraid>/psagent
SSH_USERNAME=psagent-sicherung
SSH_PORT=22
