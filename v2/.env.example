# Vorlage für die lokale Entwicklung. Als .env kopieren; .env wird nie committet.
# Ohne .env gelten die Standardwerte aus psagent/settings/dev.py.
DJANGO_SETTINGS_MODULE=psagent.settings.dev
POSTGRES_PASSWORD=psagent-dev
# Passkeys: Hostname der App und erlaubte Origins (lokal mit runserver auf Port 8000).
PSAGENT_WEBAUTHN_RP_ID=localhost
PSAGENT_WEBAUTHN_ORIGINS=http://localhost:8000
# Nur hinter Caddy im Betrieb: IP des Proxys, damit die Sperre nach Fehlversuchen die echte
# Client-Adresse aus X-Forwarded-For nimmt.
# PSAGENT_TRUSTED_PROXIES=127.0.0.1
