# Vorlage für die lokale Entwicklung. Als .env kopieren; .env wird nie committet.
# Ohne .env gelten die Standardwerte aus psagent/settings/dev.py.
DJANGO_SETTINGS_MODULE=psagent.settings.dev
POSTGRES_PASSWORD=psagent-dev
# Passkeys: Hostname der App und erlaubte Origins (lokal mit runserver auf Port 8000).
PSAGENT_WEBAUTHN_RP_ID=localhost
PSAGENT_WEBAUTHN_ORIGINS=http://localhost:8000
# Nur hinter Caddy im Betrieb: IP des Proxys, damit die Sperre nach Fehlversuchen die echte
# Client-Adresse aus X-Forwarded-For nimmt.
# PSAGENT_TRUSTED_PROXIES=127.0.0.1
# Verein als Besitzer auf der Einsatzdokumentation, z. B. „Beispielverein Sektion Musterstadt“.
# PSAGENT_CLUB_NAME=
# Adresse der App für die Links in QR-Etiketten; Etiketten nach einer Änderung neu drucken.
# PSAGENT_BASE_URL=https://psagent.example.org
# Löschfrist für Entleiherdaten in Jahren nach Ende des Jahres der letzten Ausleihe (#63);
# legt der Vorstand fest.
# PSAGENT_RETENTION_YEARS=3
# E-Mail (#72). Ohne Angabe gehen Mails in die Konsole; im Betrieb über Microsoft 365:
# PSAGENT_MAIL_BACKEND=mailer.graph.GraphEmailBackend
# PSAGENT_MAIL_FROM=psagent@example.org
# PSAGENT_MAIL_REPLY_TO=material@example.org
# PSAGENT_GRAPH_TENANT_ID=
# PSAGENT_GRAPH_CLIENT_ID=
# Pfad zur Schlüsseldatei (PEM) außerhalb des Repos, und Fingerabdruck des Zertifikats:
# PSAGENT_GRAPH_CERT_PATH=/etc/psagent/graph.pem
# PSAGENT_GRAPH_CERT_THUMBPRINT=
# Zeuge der Hash-Kette (#16, #17): Zeitstempeldienst (RFC 3161) und seine Zertifizierungsstelle,
# Zeugen-Postfach des Vorstands, Ordner für die tägliche Datei (auf Unraid gespiegelt).
# PSAGENT_TSA_URL=
# PSAGENT_TSA_CA_PATH=/etc/psagent/tsa-ca.pem
# PSAGENT_WITNESS_TO=zeuge@example.org
# PSAGENT_WITNESS_DIR=/var/lib/psagent/kettenkopf
# Zertifikatsliste (#18): Wurzelzertifikat(e) der Yubico-PIV-Bescheinigung (PEM, von Yubico) und
# die Seriennummern der zugelassenen YubiKeys, durch Komma getrennt.
# PSAGENT_YUBICO_CA_PATH=/etc/psagent/yubico-piv-ca.pem
# PSAGENT_YUBIKEY_SERIALS=
